# Copy this file to .env and fill in your key:
#   cp .env.example .env
# NEVER commit your actual .env file to Git.

# Used for live India supplier lookup and for prescription reading.
OPENROUTER_API_KEY=

# Supplier search. This model is asked for public pharmacy pages, not for photos.
OPENROUTER_MODEL=perplexity/sonar

# Prescription photos and PDFs. Use a model that can read images and PDFs.
OPENROUTER_EXTRACT_MODEL=google/gemini-2.5-flash
